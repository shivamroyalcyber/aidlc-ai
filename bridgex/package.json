{
  "name": "bridgex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BridgeX - serverless SOAP/XML <-> REST/JSON integration gateway",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "local": "tsx scripts/local-server.ts",
    "synth": "cdk synth --quiet",
    "deploy": "cdk deploy --require-approval never --outputs-file cdk-outputs.json",
    "diff": "cdk diff"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1173.0",
    "@aws-sdk/client-dynamodb": "^3.1173.0",
    "@aws-sdk/client-secrets-manager": "^3.1173.0",
    "@aws-sdk/lib-dynamodb": "^3.1173.0",
    "fast-xml-parser": "^5.12.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^26.6.6",
    "aws-cdk": "^2.1149.0",
    "aws-cdk-lib": "^2.277.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
